# Required in production. Used to sign session cookies.
SECRET_KEY=change-me-to-a-long-random-string

# Where this process is reachable. Used for Google OAuth redirect URIs.
PUBLIC_BASE_URL=http://localhost:8000

# Postgres (docker compose default). Tests override this to SQLite.
DATABASE_URL=postgresql+asyncpg://laya:laya@localhost:5432/laya

# Google OAuth Web client. Redirect URI: {PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allow a one-click local login when Google OAuth is not configured.
# Never enable this on a public host.
ALLOW_DEV_LOGIN=true

# stub = heuristic engine (no GPU, no model download)
# laya = real Laya Router (pip install 'laya-api[engine]')
ENGINE=stub
# cpu | cuda | mps. cuda needs nvidia-container-toolkit on the host
# (`sudo pacman -S nvidia-container-toolkit`) and a CUDA torch wheel.
LAYA_DEVICE=cuda
LAYA_PRELOAD=true

# Per-key sliding window.
RATE_LIMIT_RPM=180
